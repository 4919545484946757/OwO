{
  "model": "deepseek-v4-flash",
  "read_only": false,
  "deny_commands": ["git push", "shutdown"],
  "theme": "dark",
  "keybinds": {
    "toggle_mode": "tab",
    "abort": "ctrl+c",
    "scroll_up": "pageup",
    "scroll_down": "pagedown",
    "clear": "ctrl+l"
  },
  "mcp_servers": [
    {
      "name": "files",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "url": null
    }
  ]
}
