{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OwO Agent",
  "version": "0.1.0",
  "identifier": "com.owo.agent",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OwO Agent 工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://example.com/owo/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNDJBODZCOUQ5RDA4MDAKUldRQUNKMmRhNmhDMHR5VVhDcDA1YUdlMzhpS2xPRnVGbHA2UHBqR1NZVloxUkx3VENGUE5QSGEK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/owo-agent.exe"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
